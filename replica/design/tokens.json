{
  "meta": {
    "name": "Smartlytics",
    "mode": "dark",
    "source": "Smartlytics-Hub hero (user's own design): navy gradient + cyan-to-green title"
  },
  "color": {
    "bg": "#0B1220",
    "surface": "#121B2E",
    "surface-raised": "#1A2540",
    "border": "#26324D",
    "border-input": "#5B6B8C",
    "text": "#E7ECF5",
    "text-muted": "#9BA8C2",
    "accent": "#22C3EE",
    "accent-2": "#8EF0A0",
    "on-accent": "#06111F",
    "focus-ring": "#22C3EE",
    "success": "#4ADE80",
    "warning": "#FBBF24",
    "danger": "#F87171",
    "tier-high": "#4ADE80",
    "tier-medium": "#FBBF24",
    "tier-low": "#F87171",
    "hero-from": "#0A0F2C",
    "hero-via": "#0F2027",
    "hero-to": "#203A43"
  },
  "chart": {
    "categorical": ["#22C3EE", "#8EF0A0", "#A78BFA", "#FBBF24", "#F472B6", "#60A5FA", "#F87171", "#94A3B8"],
    "gridline": "#26324D",
    "axis-text": "#9BA8C2"
  },
  "font": {
    "sans": "Inter, system-ui, -apple-system, Segoe UI, sans-serif",
    "mono": "JetBrains Mono, ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "type": {
    "xs":   { "size": 12, "line": 16, "weight": 500 },
    "sm":   { "size": 14, "line": 20, "weight": 400 },
    "base": { "size": 16, "line": 24, "weight": 400 },
    "lg":   { "size": 20, "line": 28, "weight": 600 },
    "xl":   { "size": 28, "line": 36, "weight": 700 },
    "hero": { "size": 40, "line": 48, "weight": 800 },
    "metric": { "size": 28, "line": 32, "weight": 700 }
  },
  "space": [0, 4, 8, 12, 16, 24, 32, 48, 64],
  "radius": { "sm": 6, "md": 10, "lg": 14 },
  "shadow": {
    "sm": "0 1px 2px rgba(0,0,0,.35)",
    "md": "0 6px 20px rgba(0,0,0,.35)"
  },
  "motion": { "fast": "120ms", "base": "200ms", "ease": "cubic-bezier(.2,.8,.2,1)" },
  "layout": {
    "content-max": 1200,
    "sidebar": 260,
    "breakpoint-mobile": 640,
    "breakpoint-tablet": 1024
  },
  "pairs": [
    ["text", "bg", "body"],
    ["text", "surface", "body"],
    ["text", "surface-raised", "body"],
    ["text-muted", "bg", "body"],
    ["text-muted", "surface", "body"],
    ["text-muted", "surface-raised", "body"],
    ["on-accent", "accent", "body"],
    ["on-accent", "accent-2", "body"],
    ["accent", "bg", "body"],
    ["accent", "surface", "body"],
    ["accent-2", "hero-to", "large"],
    ["accent", "hero-from", "large"],
    ["text", "hero-to", "body"],
    ["success", "surface", "body"],
    ["warning", "surface", "body"],
    ["danger", "surface", "body"],
    ["tier-high", "surface", "body"],
    ["tier-medium", "surface", "body"],
    ["tier-low", "surface", "body"],
    ["border-input", "bg", "ui"],
    ["border-input", "surface", "ui"],
    ["focus-ring", "bg", "ui"],
    ["focus-ring", "surface", "ui"],
    ["axis-text", "bg", "body"]
  ]
}
