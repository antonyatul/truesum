# v1 (public demo) needs no environment variables.
#
# v2 (accounts and saved datasets) — fill these in .streamlit/secrets.toml or the host's
# secret settings, never in the repo. You create the Supabase and Stripe projects yourself.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
RESEND_API_KEY=
EMAIL_FROM=
